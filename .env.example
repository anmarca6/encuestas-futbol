# Añade la clave solo en tu entorno local o en el panel del proveedor de hosting.
FOOTBALL_DATA_API_KEY=
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Contraseña inicial de los super administradores (por defecto leo y angel_cavero; se crean la primera vez que se usa el panel).
# Después cada uno puede cambiar la suya desde /admin. También firma las sesiones del panel. Elige una tuya.
ADMIN_PASSWORD=
# (Opcional) Usuarios super administradores, separados por comas. Por defecto: leo,angel_cavero
# SUPER_ADMINS=leo,angel_cavero
# (Opcional) Clave para firmar las sesiones del panel; si no se define se usa ADMIN_PASSWORD.
# ADMIN_SESSION_SECRET=
